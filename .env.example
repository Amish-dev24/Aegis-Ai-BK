# ─────────────────────────────────────────────────────────────────────────────
# Aegis AI — Environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (AWS RDS PostgreSQL) ─────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:aegis1234@aegis-db.c7cs2usscwzo.eu-north-1.rds.amazonaws.com:5432/aegis_db

# ── Security ──────────────────────────────────────────────────────────────────
# SECRET_KEY=change-this-to-a-long-random-string-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_HOURS=2

# ── Redis (local container — set automatically by docker-compose) ─────────────
# REDIS_URL is injected by docker-compose, no need to set here.
# For bare-metal (no docker): set this manually:
# REDIS_URL=redis://localhost:6379/0

# ── File Storage ──────────────────────────────────────────────────────────────
# UPLOAD_DIR=./uploads
# EVIDENCE_DIR=./evidence
# PROCESSED_VIDEO_DIR=./processed_videos
# MAX_FILE_SIZE_MB=500

# # ── Detection Models ──────────────────────────────────────────────────────────
# MODEL_PATH=./models/weapon-box-bags-v3.pt
# FACE_MODEL_PATH=./models/face_detection.pt
# CROWD_MODEL_PATH=./models/sanet_partB_best.onnx
# CROWD_MODEL_ARCH=sanet

# ── GPU flags (auto-set by docker-compose; override here if running bare-metal)
# ONNX_PREFER_GPU=true
# TORCH_PREFER_GPU=true

# ── Email (optional) ──────────────────────────────────────────────────────────
